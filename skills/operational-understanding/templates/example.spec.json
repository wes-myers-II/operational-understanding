      "hook": "…",
      "min": 2,
      "body": "<div class=\"two\"><pre><code>Request Receive() { return Parse(read()); }</code></pre><div class=\"en\"><p>Read, then parse.</p></div></div>"
    },
    {
      "part": "check",
      "title": "the code that decides",
      "fn": "Gatekeeper.cc · Check",
      "hook": "…",
      "min": 2,
      "body": "<div class=\"two\"><pre><code>bool Check(const Request&amp; r) { return r.valid(); }</code></pre><div class=\"en\"><p>Valid requests pass.</p></div></div>"
    },
