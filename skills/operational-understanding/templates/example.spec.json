  "plain": [
    "<p>A program outside the system sends a request. One loop inside the system takes it in, checks it, hands it onward, and sends the answer back.</p>"
  ],
  "vocabulary": "<b>client</b> = the outside program, <b>downstream</b> = the thing that acts.",
