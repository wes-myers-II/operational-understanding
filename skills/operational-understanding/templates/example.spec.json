      "part": "reply",
      "title": "the code that answers",
      "fn": "Gatekeeper.cc · Reply",
      "hook": "…",
      "min": 2,
      "body": "<div class=\"two\"><pre><code>void Reply(const Result&amp; r) { send(r); }</code></pre><div class=\"en\"><p>Send it back.</p></div></div>"
    }
